# Copy to .env and fill in. Never commit .env.

# Where the dataset JSONs live (default: backend/data)
CREW_OPS_DATA_DIR=data

# Where the derived SQLite file is written (default: backend/var/crew_ops.db)
CREW_OPS_DB_PATH=var/crew_ops.db

# Where conversations are stored (default: backend/var/chats.db)
CREW_OPS_CHATS_DB_PATH=var/chats.db

# Where the built frontend lives, served at / (default: ../frontend/dist)
CREW_OPS_WEB_DIST=../frontend/dist

# LLM provider:
#   agent-sdk  Claude Agent SDK runs the loop; our tools are exposed to it as MCP tools (default)
#   anthropic  Anthropic Client SDK; we run the loop
#   offline    deterministic keyword router, no model, no key
CREW_OPS_LLM_PROVIDER=agent-sdk

# If the model provider fails (no CLI, no key, network), answer via the offline router (1/0)
CREW_OPS_OFFLINE_FALLBACK=1

# Anthropic API key. Used by both agent-sdk and anthropic providers (agent-sdk also accepts the
# Claude Code login on the machine; products built on the Agent SDK must use API-key auth).
ANTHROPIC_API_KEY=

# Model and effort (effort: low | medium | high | xhigh | max)
CREW_OPS_LLM_MODEL=claude-opus-5
CREW_OPS_LLM_EFFORT=medium

# Per-question cost cap for the Agent SDK under API-key billing (blank/none = no cap)
CREW_OPS_AGENT_MAX_BUDGET_USD=0.50

# ---- Voice (ADR-0016) -------------------------------------------------------------
# Speech-to-text: whisper (local faster-whisper model, no key) | sarvam | browser (Web Speech API)
CREW_OPS_STT_PROVIDER=whisper
CREW_OPS_WHISPER_MODEL=base
# Text-to-speech for reading answers aloud: browser (Web Speech API) | sarvam
CREW_OPS_TTS_PROVIDER=browser

# Sarvam AI (set CREW_OPS_STT_PROVIDER=sarvam and/or CREW_OPS_TTS_PROVIDER=sarvam)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_LANGUAGE=en-IN
# override only if the endpoints differ from the documented ones
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech

# Privacy and audit (ADR-0017)
# full (default): tool results go to the model as they are.
# minimal: crew names never leave this machine — dropped from tool results, replaced by crew
#          ids in questions; the UI joins names back from /api/directory.
CREW_OPS_PII_MODE=full
# Console audit trail of everything sent to the model: 1 (default) | 0 | full (no truncation)
CREW_OPS_AUDIT_LOG=1
